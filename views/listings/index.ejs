<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>WanderLust</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  </head>
  <body>
    <div class="container mt-4">
      <h3 class="mb-3">All Listings</h3>
      <form method="GET" action="/listings/new" class="mb-3">
        <button class="btn btn-primary">Create New Listing</button>
      </form>
      <div class="row row-cols-1 row-cols-md-3 g-4">
        <% for(let listing of allListings) { %>
        <div class="col">
          <div class="card h-100">
           <img src="<%= listing.image.url %>" class="card-img-top" style="height: 200px; object-fit: cover;" alt="listing image">
            <div class="card-body">
              <h5 class="card-title">
                <a href="/listings/<%= listing._id %>" class="text-decoration-none text-dark">
                  <%= listing.title %>
                </a>
              </h5>
              <p class="card-text">₹<%= listing.price %> &bull; <%= listing.location %></p>
            </div>
          </div>
        </div>
        <% } %>
      </div>
    </div>
  </body>
</html>